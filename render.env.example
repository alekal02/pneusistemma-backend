# ============================================================
# PneuSistemma — Backend (Render)
# Importe com: Environment → "Add from .env"
# ============================================================

NODE_ENV=production
HOST=0.0.0.0

# Auth
JWT_SECRET=TROQUE_POR_UM_SEGREDO_LONGO_E_ALEATORIO
JWT_EXPIRES_IN=7d
ADMIN_USER=admin
ADMIN_PASSWORD=TROQUE_ESTA_SENHA

# Frontend (Vercel)
CORS_ORIGIN=https://pneusistemma-frontend.vercel.app
FRONTEND_URL=https://pneusistemma-frontend.vercel.app
ALLOW_VERCEL_PREVIEWS=true

# ============================================================
# PostgreSQL — Neon (recomendado) ou Render Postgres
# ============================================================
# Neon: Connection Details → Connection string → URI
# Ex.: postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_SSL=true

# Limites de sulco (mm)
SULCO_MINIMO_MM=3.0
SULCO_ALERTA_MM=8.0

# WuzAPI (WhatsApp)
WUZAPI_BASE_URL=https://SEU-WUZAPI.exemplo.com
WUZAPI_TOKEN=
WUZAPI_ADMIN_TOKEN=
WUZAPI_WEBHOOK_PUBLIC_URL=https://SEU-BACKEND.onrender.com/api/webhook/whatsapp
WUZAPI_WEBHOOK_SECRET=
GERENTE_COMPRAS_WHATSAPP=5511999999999
# Alertas pós-medição: false até segunda ordem; true para religar
WHATSAPP_ALERTAS_ENABLED=false
