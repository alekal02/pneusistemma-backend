# ============================================================
# BACKEND - Configuração da API
# ============================================================

PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# ============================================================
# PostgreSQL (obrigatório) — Neon, Render Postgres ou Docker local
# ============================================================
# Neon: Dashboard → Connection string → URI (copie com SSL)
#   postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Docker local:
#   postgresql://pneu:pneu123@localhost:5434/pneusistemma
DATABASE_URL=postgresql://pneu:pneu123@localhost:5434/pneusistemma

# Neon / produção: true  |  Docker local sem SSL: false
DATABASE_SSL=false

# Limites de sulco (mm)
SULCO_MINIMO_MM=3.0
SULCO_ALERTA_MM=8.0

# URL do frontend (CORS) — uma ou várias separadas por vírgula
CORS_ORIGIN=http://localhost:5173

# Autenticação
JWT_SECRET=altere-este-segredo-em-producao
# JWT_EXPIRES_IN não é mais lido.
SESSAO_OCIOSIDADE_MIN=30
SESSAO_DURACAO_HORAS=12
SESSAO_TOQUE_MIN=1
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# URL pública do frontend (links WhatsApp / acesso rápido)
FRONTEND_URL=http://localhost:5173
ALLOW_VERCEL_PREVIEWS=true

# ============================================================
# WuzAPI (WhatsApp)
# ============================================================
WUZAPI_BASE_URL=http://localhost:8080
WUZAPI_TOKEN=
WUZAPI_ADMIN_TOKEN=1234ABCD
WUZAPI_WEBHOOK_PUBLIC_URL=http://host.docker.internal:3000/api/webhook/whatsapp
WUZAPI_WEBHOOK_SECRET=
GERENTE_COMPRAS_WHATSAPP=5511999999999

# Alertas WhatsApp após medição crítica/monitorar (false = desligado)
WHATSAPP_ALERTAS_ENABLED=false
