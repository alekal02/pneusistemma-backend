# ============================================================
# BACKEND - Configuração da API
# ============================================================

PORT=3000
NODE_ENV=development
# Em produção (Render) use 0.0.0.0 — é o padrão se NODE_ENV=production
HOST=0.0.0.0

# Banco SQLite
# Local: ./data/pneus.db
# Render (com disco em /var/data): /var/data/pneus.db
DB_PATH=./data/pneus.db

# Limites de sulco (mm)
SULCO_MINIMO_MM=3.0
SULCO_ALERTA_MM=8.0

# URL do frontend (CORS) — uma ou várias separadas por vírgula
# Local: http://localhost:5173
# Produção: https://pneusistemma-frontend.vercel.app
CORS_ORIGIN=http://localhost:5173

# Autenticação
JWT_SECRET=altere-este-segredo-em-producao
JWT_EXPIRES_IN=7d
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# URL pública do frontend (links WhatsApp / acesso rápido)
FRONTEND_URL=http://localhost:5173

# Libera CORS para previews *.vercel.app
ALLOW_VERCEL_PREVIEWS=true

# ============================================================
# WuzAPI (WhatsApp)
# ============================================================
WUZAPI_BASE_URL=http://localhost:8080
# Token de usuário WuzAPI (não use o admin aqui)
WUZAPI_TOKEN=
WUZAPI_ADMIN_TOKEN=1234ABCD
# Local (Docker): http://host.docker.internal:3000/api/webhook/whatsapp
# Produção (Render): https://SEU-BACKEND.onrender.com/api/webhook/whatsapp
WUZAPI_WEBHOOK_PUBLIC_URL=http://host.docker.internal:3000/api/webhook/whatsapp
WUZAPI_WEBHOOK_SECRET=
GERENTE_COMPRAS_WHATSAPP=5511999999999
