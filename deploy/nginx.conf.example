# ============================================================
# NGINX - Frontend + API (projetos separados)
# ============================================================
#
# Estrutura:
#   /          → frontend/dist (arquivos estáticos)
#   /api/*     → backend Node.js na porta 3000
#
# Copie para o servidor:
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/pneu-controle
#   sudo ln -s /etc/nginx/sites-available/pneu-controle /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
# ============================================================

server {
    listen 80;
    server_name pneus.suaempresa.com.br;

    charset utf-8;
    source_charset utf-8;

    root /var/www/pneu-controle/frontend/dist;
    index index.html;

    # API — proxy para o backend Node.js
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA — redireciona rotas do frontend para index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache de assets com hash (Vite gera nomes únicos)
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}

# SSL com Certbot:
#   sudo certbot --nginx -d pneus.suaempresa.com.br
